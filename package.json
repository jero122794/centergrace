{
  "name": "shalom-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma de estudios bíblicos y gestión de ministerios — Centro Misionero Shalom",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml}\"",
    "setup:local": "node scripts/setup-local.mjs",
    "dev:infra": "docker compose up -d postgres redis",
    "db:migrate": "npm run prisma:migrate --workspace=apps/api",
    "db:seed": "npm run prisma:seed --workspace=apps/api"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
