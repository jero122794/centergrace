// apps/api/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DEVELOPER
  ADMIN
  LEADER
  STUDENT
}

enum ContentScope {
  GLOBAL
  GROUP
}

enum LessonStatus {
  DRAFT
  PUBLISHED
}

enum DevotionalStatus {
  DRAFT
  PUBLISHED
}

enum SubmissionStatus {
  PENDING
  GRADED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum AuditionStatus {
  PENDING
  SCHOOL
  ELIGIBLE
  SCHEDULED
  APPROVED
  REJECTED
  WAITLIST
}

enum MusicalRole {
  VOCALIST
  GUITARIST
  BASSIST
  DRUMMER
  KEYBOARDIST
  SOUND
  OTHER
}

enum GroupType {
  MINISTRY
  CELL
  BIBLE_CLASS
  PRAYER
  OTHER
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  passwordHash       String
  role               Role      @default(STUDENT)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  googleSub          String?   @unique
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  createdBy                User?                     @relation("CreatedBy", fields: [createdById], references: [id])
  createdUsers             User[]                    @relation("CreatedBy")
  ledMinistries            Ministry[]                @relation("MinistryLeader")
  createdMinistries        Ministry[]                @relation("MinistryCreator")
  ledGroups                Group[]                   @relation("GroupLeader")
  createdGroups            Group[]                   @relation("GroupCreator")
  groupMemberships         GroupMembership[]
  ministryMemberships      MinistryMembership[]
  enrollments              Enrollment[]
  submissions              Submission[]
  gradesGiven              Grade[]                   @relation("GradedBy")
  devotionalsAuthored      Devotional[]              @relation("DevotionalAuthor")
  participations           Participation[]
  spiritualNotes           SpiritualNote[]           @relation("NoteAbout")
  notesWritten             SpiritualNote[]           @relation("NoteBy")
  pushSubscriptions        PushSubscription[]
  refreshTokens            RefreshToken[]
  auditLogs                AuditLog[]
  worshipMemberRoles       MinistryMemberRole[]
  rehearsalAttendance      RehearsalAttendance[]
  auditions                Audition[]
  worshipSchoolEnrollments WorshipSchoolEnrollment[]
  coursesCreated           Course[]
  lessonProgress           LessonProgress[]
  songsCreated             Song[]                    @relation("SongCreator")
  rehearsalsCreated        Rehearsal[]               @relation("RehearsalCreator")
  inAppNotifications       InAppNotification[]
}

model Ministry {
  id          String    @id @default(cuid())
  name        String
  description String?
  type        GroupType
  coverImage  String?
  isActive    Boolean   @default(true)
  leaderId    String
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  leader              User                  @relation("MinistryLeader", fields: [leaderId], references: [id])
  createdBy           User                  @relation("MinistryCreator", fields: [createdById], references: [id])
  groups              Group[]
  memberships         MinistryMembership[]
  songs               Song[]
  rehearsals          Rehearsal[]
  auditions           Audition[]
  memberRoles         MinistryMemberRole[]
  worshipSchoolConfig WorshipSchoolConfig?
  schoolEnrollments   WorshipSchoolEnrollment[]
}

model Group {
  id          String    @id @default(cuid())
  name        String
  description String?
  type        GroupType
  isActive    Boolean   @default(true)
  ministryId  String?
  leaderId    String
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  ministry        Ministry?         @relation(fields: [ministryId], references: [id])
  leader          User              @relation("GroupLeader", fields: [leaderId], references: [id])
  createdBy       User              @relation("GroupCreator", fields: [createdById], references: [id])
  memberships     GroupMembership[]
  courses         GroupCourse[]
  devotionals     GroupDevotional[]
  spiritualNotes  SpiritualNote[]
}

model GroupMembership {
  id        String           @id @default(cuid())
  userId    String
  groupId   String
  addedById String
  status    MembershipStatus @default(ACTIVE)
  joinedAt  DateTime         @default(now())

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId])
}

model MinistryMembership {
  id         String           @id @default(cuid())
  userId     String
  ministryId String
  addedById  String
  status     MembershipStatus @default(ACTIVE)
  joinedAt   DateTime         @default(now())

  user     User     @relation(fields: [userId], references: [id])
  ministry Ministry @relation(fields: [ministryId], references: [id])

  @@unique([userId, ministryId])
}

model Course {
  id          String       @id @default(cuid())
  title       String
  description String
  coverImage  String?
  scope       ContentScope @default(GROUP)
  isActive    Boolean      @default(true)
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  createdBy   User           @relation(fields: [createdById], references: [id])
  modules     CourseModule[]
  lessons     Lesson[]
  enrollments Enrollment[]
  groups      GroupCourse[]
  schoolCourses WorshipSchoolCourse[]
}

model CourseModule {
  id       String @id @default(cuid())
  courseId String
  title    String
  order    Int

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]
}

model Lesson {
  id                    String       @id @default(cuid())
  courseId              String
  moduleId              String?
  title                 String
  bodyContent           Json
  youtubeId             String?
  youtubeTitle          String?
  youtubeThumbnail      String?
  order                 Int
  status                LessonStatus @default(DRAFT)
  hasAssignment         Boolean      @default(false)
  assignmentDescription String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module      CourseModule?    @relation(fields: [moduleId], references: [id])
  submissions Submission[]
  progress    LessonProgress[]
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

model LessonProgress {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  completed Boolean  @default(false)
  viewedAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model GroupCourse {
  groupId    String
  courseId   String
  assignedAt DateTime @default(now())
  assignedBy String

  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([groupId, courseId])
}

model Devotional {
  id        String           @id @default(cuid())
  authorId  String
  title     String
  content   Json
  verse     String?
  mediaUrl  String?
  mediaType String?
  date      DateTime         @db.Date
  scope     ContentScope     @default(GROUP)
  status    DevotionalStatus @default(DRAFT)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  author         User                 @relation("DevotionalAuthor", fields: [authorId], references: [id])
  questions      DevotionalQuestion[]
  participations Participation[]
  groups         GroupDevotional[]

  @@unique([date, status])
}

model DevotionalQuestion {
  id           String @id @default(cuid())
  devotionalId String
  text         String
  order        Int

  devotional Devotional            @relation(fields: [devotionalId], references: [id], onDelete: Cascade)
  answers    ParticipationAnswer[]
}

model GroupDevotional {
  groupId      String
  devotionalId String
  assignedAt   DateTime @default(now())

  group      Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  devotional Devotional @relation(fields: [devotionalId], references: [id], onDelete: Cascade)

  @@id([groupId, devotionalId])
}

model Participation {
  id           String   @id @default(cuid())
  devotionalId String
  userId       String
  content      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  devotional Devotional            @relation(fields: [devotionalId], references: [id], onDelete: Cascade)
  user       User                  @relation(fields: [userId], references: [id])
  answers    ParticipationAnswer[]

  @@unique([devotionalId, userId])
}

model ParticipationAnswer {
  id              String @id @default(cuid())
  participationId String
  questionId      String
  answer          String

  participation Participation      @relation(fields: [participationId], references: [id], onDelete: Cascade)
  question      DevotionalQuestion @relation(fields: [questionId], references: [id])
}

model Submission {
  id        String           @id @default(cuid())
  lessonId  String
  userId    String
  content   String
  fileUrl   String?
  status    SubmissionStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])
  grade  Grade?

  @@unique([lessonId, userId])
}

model Grade {
  id           String   @id @default(cuid())
  submissionId String   @unique
  gradedById   String
  score        Int
  feedback     String?
  gradedAt     DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  gradedBy   User       @relation("GradedBy", fields: [gradedById], references: [id])
}

model SpiritualNote {
  id        String   @id @default(cuid())
  userId    String
  leaderId  String
  groupId   String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User  @relation("NoteAbout", fields: [userId], references: [id])
  leader User  @relation("NoteBy", fields: [leaderId], references: [id])
  group  Group @relation(fields: [groupId], references: [id])
}

model Song {
  id          String   @id @default(cuid())
  ministryId  String
  title       String
  artist      String?
  originalKey String
  chords      Json
  lyrics      String?
  youtubeId   String?
  tags        String[]
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ministry       Ministry        @relation(fields: [ministryId], references: [id])
  createdBy      User            @relation("SongCreator", fields: [createdById], references: [id])
  rehearsalSongs RehearsalSong[]
}

model Rehearsal {
  id          String   @id @default(cuid())
  ministryId  String
  date        DateTime
  location    String?
  notes       String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ministry   Ministry              @relation(fields: [ministryId], references: [id])
  createdBy  User                  @relation("RehearsalCreator", fields: [createdById], references: [id])
  songs      RehearsalSong[]
  attendance RehearsalAttendance[]
}

model RehearsalSong {
  rehearsalId String
  songId      String
  order       Int
  key         String
  isReady     Boolean @default(false)

  rehearsal Rehearsal @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  song      Song      @relation(fields: [songId], references: [id])

  @@id([rehearsalId, songId])
}

model RehearsalAttendance {
  rehearsalId String
  userId      String
  confirmed   Boolean?
  respondedAt DateTime?

  rehearsal Rehearsal @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@id([rehearsalId, userId])
}

model Audition {
  id          String         @id @default(cuid())
  userId      String
  ministryId  String
  status      AuditionStatus @default(PENDING)
  scheduledAt DateTime?
  musicalRole MusicalRole?
  notes       String?
  evaluatedBy String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  ministry Ministry @relation(fields: [ministryId], references: [id])
}

model MinistryMemberRole {
  userId      String
  ministryId  String
  musicalRole MusicalRole
  joinedAt    DateTime    @default(now())

  user     User     @relation(fields: [userId], references: [id])
  ministry Ministry @relation(fields: [ministryId], references: [id])

  @@id([userId, ministryId])
}

model WorshipSchoolConfig {
  id          String @id @default(cuid())
  ministryId  String @unique
  minProgress Int    @default(80)

  ministry        Ministry              @relation(fields: [ministryId], references: [id])
  requiredCourses WorshipSchoolCourse[]
}

model WorshipSchoolCourse {
  configId String
  courseId String

  config WorshipSchoolConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  course Course              @relation(fields: [courseId], references: [id])

  @@id([configId, courseId])
}

model WorshipSchoolEnrollment {
  id          String   @id @default(cuid())
  userId      String
  ministryId  String
  canAudition Boolean  @default(false)
  enrolledAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  ministry Ministry @relation(fields: [ministryId], references: [id])

  @@unique([userId, ministryId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InAppNotification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  url       String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([entity, entityId])
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String
  message   String
  context   String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([level, createdAt])
}

model ChurchSetting {
  id           String   @id @default("singleton")
  churchName   String
  logoUrl      String?
  primaryColor String
  accentColor  String
  updatedAt    DateTime @updatedAt
}

model JobRun {
  id         String    @id @default(cuid())
  name       String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?
  status     String
  result     Json?

  @@index([name, startedAt])
}
